  "script": [
    {
      "id": "scene1",
      "type": "scene",
      "shots": [
        "s01"
      ],
      "text": "INT. BEDROOM — BEFORE DAWN"
    },
    {
      "id": "joe_wakes",
      "type": "action",
      "shots": [
        "s01"
      ],
      "text": "A television speaks from another room, low and patient. Joe, sixteen, wakes with blue light moving across his face like water."
    },
    {
      "id": "announcer",
      "type": "dialogue",
      "speaker": "announcer",
      "shots": [
        "s01",
        "s02",
        "s03",
        "s04",
        "s05",
        "s06"
      ],
      "text": "Everything is normal. Please remain seated."
    },
    {
      "id": "scene2",
      "type": "scene",
      "shots": [
        "s02",
        "s03",
        "s04",
        "s05",
        "s06",
        "s07",
        "s08"
      ],
      "text": "INT. LIVING ROOM — BEFORE DAWN"
    },
    {
      "id": "parents_sofa",
      "type": "action",
      "shots": [
        "s02"
      ],
      "text": "In the living room, Pete and Donna sit side by side on the sofa. Their hands rest on their knees. Their eyes do not blink."
    },
    {
      "id": "crt_signal",
      "type": "action",
      "shots": [
        "s03"
      ],
      "text": "The screen shows a perfect white street full of sheep. The apartment is too still to believe the broadcast."
    },
    {
      "id": "joe_question",
      "type": "dialogue",
      "speaker": "joe",
      "shots": [
        "s04"
      ],
      "paren": "(whispering)",
      "text": "Dad. Mom. Can you hear me?"
    },
    {
      "id": "first_morph",
      "type": "action",
      "shots": [
        "s05"
      ],
      "text": "The skin along Pete’s cheek tightens, then dimples into pale wool. His lips barely move."
    },
    {
      "id": "pete_static",
      "type": "dialogue",
      "speaker": "pete",
      "shots": [
        "s05"
      ],
      "paren": "(lips barely moving)",
      "text": "We are fine. The world is fine."
    },
    {
      "id": "hammer_choice",
      "type": "action",
      "shots": [
        "s06"
      ],
      "text": "Joe finds the hammer beside the radiator. He lifts it, but the tool becomes impossibly heavy."
    },
    {
      "id": "screen_break",
      "type": "action",
      "shots": [
        "s07"
      ],
      "text": "He swings anyway. Glass flowers outward. The announcer cuts off. The room mutes."
    },
    {
      "id": "false_relief",
      "type": "action",
      "shots": [
        "s08"
      ],
      "text": "Static floods back. For one second Pete and Donna look almost human."
    },
    {
      "id": "donna_warning",
      "type": "dialogue",
      "speaker": "donna",
      "shots": [
        "s08"
      ],
      "paren": "(softly)",
      "text": "Do not go outside, sweetheart."
    },
    {
      "id": "scene3",
      "type": "scene",
      "shots": [
        "s09",
        "s10",
        "s11",
        "s12"
      ],
      "text": "EXT. BALCONY — DAWN"
    },
    {
      "id": "balcony_reveal",
      "type": "action",
      "shots": [
        "s09"
      ],
      "text": "Joe backs through the balcony door. The city below is silent and overexposed."
    },
    {
      "id": "flock",
      "type": "action",
      "shots": [
        "s10"
      ],
      "text": "Thousands of sheep stand in the street, all facing his building."
    },
    {
      "id": "final_hold",
      "type": "action",
      "shots": [
        "s11"
      ],
      "text": "Behind Joe, the broken television keeps flickering. Ahead, the flock waits without moving."
    },
    {
      "id": "black",
      "type": "action",
      "shots": [
        "s12"
      ],
      "text": "CUT TO BLACK. Noise and breath; end card."
    }
  ],
